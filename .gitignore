# Artefacts de compilation Swift
.build/
dist/
*.dSYM/

# macOS
.DS_Store

# Python (prototype archivé)
__pycache__/
*.pyc

# Les bibliothèques de Vendor/ SONT versionnées : elles constituent le cœur
# de la distribution (l'utilisateur final n'installe rien).

# The Xcode project is committed: cloning the repository is enough to open and
# build it. Only the per-machine state inside it is ignored — window positions,
# open tabs, local breakpoints — which differs for everyone and would conflict
# for no reason.
xcuserdata/
DerivedData/

# The backend key is not in this public repository. Without it the app builds
# and runs; it simply does not offer to send a message.
App/BrailliantConnect/AppBackendSecret.plist
