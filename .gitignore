# Artefacts de compilation Swift
.build/
dist/
*.dSYM/

# macOS
.DS_Store

# Python (prototype archivé)
__pycache__/
*.pyc

# Les bibliothèques de Vendor/ SONT versionnées : elles constituent le cœur
# de la distribution (l'utilisateur final n'installe rien).

# Projet Xcode : artefact régénéré par « xcodegen generate --spec App/project.yml ».
# La source de vérité est App/project.yml ; un project.pbxproj versionné serait
# illisible en diff et provoquerait des conflits constants.
App/*.xcodeproj/
DerivedData/
