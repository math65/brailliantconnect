<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
The agent's Info.plist is otherwise generated by Xcode (GENERATE_INFOPLIST_FILE);
this file only adds what the generator has no setting for, and Xcode merges the
two. Everything here is read by Sparkle. See "Updates" in CLAUDE.md.
-->
<dict>
	<!-- Committed at the repository root, served by GitHub over HTTPS. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/math65/brailliantconnect/main/appcast.xml</string>
	<!--
	The Ed25519 public key matching the private key in the author's keychain
	(Sparkle's default account, shared with his other apps). Print it with
	`generate_keys -p`. make-dist.sh refuses to package while this placeholder
	is here, and without a valid key Sparkle refuses to start: Debug builds
	then simply have no "Check for Updates…" item.
	-->
	<key>SUPublicEDKey</key>
	<string>PLACEHOLDER-replace-with-the-output-of-generate_keys-p</string>
	<!-- Checking is on from the start: no "check automatically?" prompt. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Download and install scheduled updates without asking. -->
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<!-- About once a day. -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Nothing about the Mac is appended to the feed request. -->
	<key>SUEnableSystemProfiling</key>
	<false/>
</dict>
</plist>
